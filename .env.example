# =============================================================================
# APS-RAG — secrets & environment overrides
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# is auto-loaded on startup. NEVER commit real credentials.
# =============================================================================

# ── LLM backend (OpenAI-compatible gateway) ──────────────────────────────────
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-key-here            # leave blank for local gateways (Ollama, LM Studio…)
LLM_MODEL=gpt-4o-mini

# ── Elasticsearch (BM25 keyword store) ───────────────────────────────────────
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me

# ── Neo4j (knowledge graph) — only needed for KG build / graph retrieval ──────
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# ── Optional: institution-internal Argo backend (only if LLM_PROVIDER=argo) ──
# ARGO_USERNAME=your-username
# ARGO_BASE_URL=https://your-argo-gateway.example.com/api/v1/resource

# ── Non-secret settings (hosts, models, device) live in config/config.yaml ──
#    Copy config/config.example.yaml → config/config.yaml and edit there.
